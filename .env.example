# ==============================================================================
# Resume.AI 基础运行环境配置模板 (.env.example)
# 复制本文件为 .env 并按实际部署环境调整参数
# ==============================================================================

# 应用元数据
APP_NAME=Resume.AI Backend
APP_ENV=development
DEBUG=true
PORT=8001
API_V1_PREFIX=/api/v1

# 数据库连接串 (默认优先 MySQL，支持连接池与异步驱动)
# 格式: mysql+aiomysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/resume_ai?charset=utf8mb4

# Redis 缓存与分布式锁连接 (可选)
REDIS_URL=redis://127.0.0.1:6379/0

# 主大语言模型配置 (DeepSeek / OpenAI 兼容接口)
LLM_PROVIDER=deepseek
LLM_API_KEY=your_primary_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 备用大模型配置 (支持 302.ai / GPT-4o-mini / Gemini 等高可用降级网关)
SECONDARY_LLM_API_KEY=your_secondary_llm_api_key_here
SECONDARY_LLM_BASE_URL=https://api.302.ai/v1
SECONDARY_LLM_MODEL=gpt-4o-mini

# CORS 跨域域名白名单 (逗号分隔 JSON 数组)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 物理文件与简历原件存储目录 (支持绝对路径或相对于 backend 的相对路径)
STORAGE_DIR=storage
