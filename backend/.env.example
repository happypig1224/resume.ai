# ==============================================================================
# Resume.AI 后端环境变量配置
# ==============================================================================

# 应用基础配置
APP_NAME=Resume.AI Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# 数据库配置 (本地开发默认使用 SQLite 异步引擎，支持无依赖即开即用)
# 生产或 Docker 环境可切换为: postgresql+asyncpg://postgres:postgres@localhost:5432/resume_ai
DATABASE_URL=sqlite+aiosqlite:///./resume_ai.db

# Redis 配置 (用于任务队列与 SSE 实时广播，默认本地单机)
REDIS_URL=redis://localhost:6379/0

# CORS 跨域白名单 (允许前端开发端口访问)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# 文件存储路径
STORAGE_DIR=./storage
